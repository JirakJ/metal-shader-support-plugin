<idea-plugin>
    <id>com.jakubjirak.metalshader</id>
    <name>Metal Shader Support</name>
    <vendor email="support@jakubjirak.com" url="https://jakubjirak.com">Jakub Jirák</vendor>

    <description><![CDATA[<h2>Metal Shader Support — Full Metal Shading Language IDE for JetBrains</h2>

<p>
Build high-performance GPU shaders with full IDE power. Metal Shader Support delivers comprehensive Metal Shading Language support — from intelligent code completion with 300+ documented keywords to real-time shader preview and GPU profiling. Supports Metal 3.2 and Metal 4.0 for iOS, macOS, and visionOS development.
</p>

<h3>Language Support</h3>
<ul>
  <li>Full Metal 3.2 and Metal 4.0 syntax highlighting</li>
  <li>Keywords: kernel, vertex, fragment, device, threadgroup</li>
  <li>Types: float4, texture2d, sampler, matrices, vectors</li>
  <li>Attributes: [[texture(0)]], [[buffer(0)]], [[stage_in]]</li>
  <li>300+ built-in functions with inline documentation</li>
  <li>Raytracing and mesh shader support (Metal 4.0)</li>
</ul>

<h3>Code Editing</h3>
<ul>
  <li>Context-aware code completion with parameter hints</li>
  <li>10 live templates for vertex, fragment, and compute shaders</li>
  <li>Code folding, formatting, and structure view</li>
  <li>Comment/uncomment, brace matching, quote handling</li>
  <li>Find usages and documentation provider</li>
</ul>

<h3>Error Detection and Analysis</h3>
<ul>
  <li>Real-time threadgroup size validation (max 1024 threads)</li>
  <li>Texture access bounds checking</li>
  <li>Attribute format validation</li>
  <li>Vector swizzle validation</li>
  <li>Performance inspection with optimization hints</li>
</ul>

<ul>
  <li>Live shader preview at 60 FPS in a dedicated tool window</li>
  <li>Metal debugger panel with variable inspection</li>
  <li>GPU profiler with cycle estimation and bottleneck detection</li>
  <li>Shader optimizer with one-click apply</li>
  <li>Shader complexity analyzer</li>
</ul>

<ul>
  <li>Cross-platform transpiler: Metal to SPIR-V, HLSL, and WGSL</li>
  <li>Team collaboration features</li>
  <li>CI/CD integration</li>
</ul>

<h3>Requirements</h3>
<ul>
  <li>IntelliJ IDEA 2024.1+ / CLion 2024.1+ / AppCode 2024.1+</li>
  <li>Java 21 or higher</li>
  <li>macOS recommended (Metal is an Apple-only framework)</li>
</ul>

<h3>Support</h3>
<ul>
  <li>Issues: <a href="https://github.com/JirakJ/metal-shader-support-plugin/issues">GitHub Issues</a></li>
  <li>Email: support@jakubjirak.com</li>
  <li>Documentation: <a href="https://github.com/JirakJ/metal-shader-support-plugin/wiki">Wiki</a></li>
</ul>]]></description>

    <change-notes><![CDATA[
        <h3>What's New</h3>
        <ul>
            <li><b>Metal 3.2 and 4.0 Support</b> - Full syntax highlighting for the latest Metal specifications including raytracing and mesh shaders</li>
            <li><b>Smart Code Completion</b> - 300+ documented keywords, types, and built-in functions with inline documentation</li>
            <li><b>Real-Time Error Detection</b> - Threadgroup size validation, texture access checks, and attribute format validation</li>
            <li><b>Performance Analyzer</b> - Shader complexity scoring with optimization hints for expensive operations</li>
            <li><b>Live Shader Preview</b> - Real-time inline shader rendering at 60 FPS in a dedicated tool window</li>
            <li><b>GPU Profiler</b> - GPU cycle estimation, bottleneck detection, and performance charts</li>
            <li><b>Metal Performance Shaders</b> - Code completion and support for the MPS framework</li>
            <li><b>10 Live Templates</b> - Quick boilerplate snippets for vertex, fragment, and compute shaders</li>
            <li><b>Cross-Platform Transpiler</b> - Convert Metal shaders to SPIR-V, HLSL, and WGSL formats</li>
        </ul>
    ]]></change-notes>

    <!-- FREEMIUM MARKETPLACE CONFIGURATION -->
    <product-descriptor code="PMETALSHADERSUP" release-date="20260215" release-version="20262" optional="true"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <!-- Dynamic Plugin Listeners - NO RESTART REQUIRED! -->
    <applicationListeners>
        <listener class="com.jakubjirak.metalshader.listeners.PluginLifecycleListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <!-- License Manager -->
        <applicationService
                serviceImplementation="com.jakubjirak.metalshader.licensing.MetalLicenseManager"/>
        
        <!-- Startup Activity for License Notifications -->
        <postStartupActivity implementation="com.jakubjirak.metalshader.licensing.LicenseStartupActivity"/>
        
        <!-- Notification Group -->
        <notificationGroup id="Metal Shader Support" displayType="BALLOON" isLogByDefault="false"/>
        <!-- File Type -->
        <fileType
                name="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalFileType"
                fieldName="INSTANCE"
                language="Metal"
                extensions="metal;msl;mm;h;hpp"/>
        
        <!-- File Type Factory for patterns -->
        <fileType.fileViewProviderFactory
                filetype="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalFileViewProviderFactory"/>

        <!-- Language -->
        <lang.parserDefinition
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalParserDefinition"/>

        <!-- Syntax Highlighter -->
        <lang.syntaxHighlighterFactory
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.highlighting.MetalSyntaxHighlighterFactory"/>

        <!-- Color Settings -->
        <colorSettingsPage
                implementation="com.jakubjirak.metalshader.highlighting.MetalColorSettingsPage"/>

        <!-- Code Completion -->
        <completion.contributor
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.completion.MetalCompletionContributor"/>
        <completion.contributor
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.completion.MetalMPSCompletionContributor"/>

        <!-- Annotator for error detection -->
        <annotator
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.annotator.MetalAnnotator"/>
        
        <!-- Performance Inspection -->
        <localInspection
                language="Metal"
                shortName="MetalPerformance"
                displayName="Metal Performance Hints"
                groupName="Metal"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.jakubjirak.metalshader.inspections.MetalPerformanceInspection"/>

        <!-- Commenter -->
        <lang.commenter
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalCommenter"/>

        <!-- Brace Matcher -->
        <lang.braceMatcher
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalBraceMatcher"/>

        <!-- Quote Handler -->
        <lang.quoteHandler
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalQuoteHandler"/>

        <!-- Live Templates -->
        <defaultLiveTemplates file="/liveTemplates/Metal.xml"/>
        <liveTemplateContext
                contextId="METAL"
                implementation="com.jakubjirak.metalshader.language.MetalTemplateContextType"/>
        
        <!-- Code Folding -->
        <lang.foldingBuilder
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalFoldingBuilder"/>
        
        <!-- Structure View -->
        <lang.psiStructureViewFactory
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalStructureViewFactory"/>
        
        <!-- Find Usages -->
        <lang.findUsagesProvider
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalFindUsagesProvider"/>
        
        <!-- Formatter -->
        <lang.formatter
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalFormattingModelBuilder"/>
        
        <!-- Documentation Provider -->
        <lang.documentationProvider
                language="Metal"
                implementationClass="com.jakubjirak.metalshader.language.MetalDocumentationProvider"/>
        
        <!-- File Template -->
        <internalFileTemplate name="Metal Shader"/>
        <internalFileTemplate name="Metal Kernel"/>
        <internalFileTemplate name="Metal Header"/>
        
        <!-- Tool Windows -->
        <toolWindow id="Metal Shader Preview"
                    factoryClass="com.jakubjirak.metalshader.pro.preview.MetalShaderPreviewToolWindowFactory"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowRun"/>
        
        <toolWindow id="Metal Debugger"
                    factoryClass="com.jakubjirak.metalshader.pro.debugger.MetalDebuggerToolWindowFactory"
                    anchor="bottom"
                    icon="AllIcons.Toolwindows.ToolWindowDebugger"/>
        
        <toolWindow id="Metal Profiler"
                    factoryClass="com.jakubjirak.metalshader.pro.profiler.MetalProfilerToolWindowFactory"
                    anchor="bottom"
                    icon="AllIcons.Actions.ProfileCPU"/>
        
        <!-- Project Services -->
        <projectService serviceImplementation="com.jakubjirak.metalshader.pro.preview.MetalShaderPreviewService"/>
        <projectService serviceImplementation="com.jakubjirak.metalshader.enterprise.transpiler.MetalTranspilerService"/>
    
        <notificationGroup id="Metal Shader Support Feedback" displayType="BALLOON"/>
        <projectActivity implementation="com.jakubjirak.metalshader.feedback.FeedbackNotifier"/>
    </extensions>

    <actions>
        <!-- Metal Shader Support submenu -->
        <group id="Metal.Menu" text="Metal Shader Support" description="Metal shader tools" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            
            <!-- License Management -->
            <group id="Metal.LicenseGroup" text="License" description="License management" popup="true">
                <action id="Metal.ActivateLicense"
                        class="com.jakubjirak.metalshader.licensing.LicenseActivationAction"
                        text="Activate License..."
                        description="Activate Metal Shader Support Pro license">
                </action>
                <action id="Metal.LicenseInfo"
                        class="com.jakubjirak.metalshader.licensing.LicenseInfoAction"
                        text="License Information"
                        description="View current license status">
                </action>
                <action id="Metal.DeactivateLicense"
                        class="com.jakubjirak.metalshader.licensing.DeactivateLicenseAction"
                        text="Deactivate License"
                        description="Deactivate current license">
                </action>
            </group>
            
            <separator/>
            
            <!-- Shader Tools -->
            <action id="Metal.AnalyzeComplexity"
                    class="com.jakubjirak.metalshader.actions.AnalyzeShaderComplexityAction"
                    text="Analyze Shader Complexity (Pro)"
                    description="Analyze Metal shader performance and complexity">
            </action>
            <action id="Metal.ProfileShader"
                    class="com.jakubjirak.metalshader.pro.ProfileShaderAction"
                    text="Profile Shader Performance (Pro)"
                    description="Estimate GPU cycles and identify bottlenecks">
            </action>
            <action id="Metal.ValidateShader"
                    class="com.jakubjirak.metalshader.pro.ValidateShaderAction"
                    text="Validate Shader (Pro)"
                    description="Advanced shader validation and error detection">
            </action>
            <action id="Metal.OptimizeShader"
                    class="com.jakubjirak.metalshader.pro.OptimizeShaderAction"
                    text="Optimize Shader (Pro)"
                    description="Automatic shader optimization suggestions">
            </action>
            <action id="Metal.ProfilerNew"
                    class="com.jakubjirak.metalshader.pro.profiler.ShaderProfilerAction"
                    text="GPU Profiler (Pro)"
                    description="Detailed GPU performance analysis">
            </action>
            <action id="Metal.Transpile"
                    class="com.jakubjirak.metalshader.enterprise.transpiler.TranspileAction"
                    text="Transpile Shader (Enterprise)"
                    description="Convert Metal shaders to SPIR-V/HLSL/WGSL">
            </action>
        </group>
        
        <!-- Context menu for Metal files -->
        <group id="Metal.EditorPopup">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <separator/>
            <action id="Metal.AnalyzeComplexity.Popup"
                    class="com.jakubjirak.metalshader.actions.AnalyzeShaderComplexityAction"
                    text="Analyze Metal Shader Complexity"
                    description="Analyze shader performance">
            </action>
        </group>
    </actions>
</idea-plugin>
